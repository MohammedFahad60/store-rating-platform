# ==========================================
# STORE Platform - Frontend environment
# Copy to .env if you need to override the defaults.
# ==========================================

# Base URL of the backend API (must end with /api).
# When unset, the app uses the relative "/api" origin:
#   - development: the Vite dev server proxies /api -> http://localhost:5000
#     (override with VITE_PROXY_TARGET)
#   - production:  the frontend and API share an origin or a reverse proxy
#     routes /api to the backend.
# For static hosting on a different domain (Vercel/Netlify/CF Pages) set the
# deployed backend URL at BUILD time, e.g.:
# VITE_API_URL=https://store-api.example.com/api
#VITE_API_URL=

# Dev-server proxy target (development only).
#VITE_PROXY_TARGET=http://localhost:5000

# Comma-separated extra dev-server allowed hosts (development only).
#VITE_ALLOWED_HOSTS=example.com,preview.example.com
